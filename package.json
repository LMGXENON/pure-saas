{
  "name": "pure-saas",
  "version": "1.0.0",
  "description": "Universal AI-agent skill and design enforcement toolkit for professional web design and UI/UX without generic AI patterns",
  "type": "module",
  "main": "scripts/pure-saas.mjs",
  "bin": {
    "pure-saas": "./scripts/pure-saas.mjs"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:tokens": "node --test tests/token-tests/*.test.mjs",
    "test:enforcement": "node --test tests/enforcement-tests/*.test.mjs",
    "test:agents": "node --test tests/agent-workflow-tests/*.test.mjs",
    "test:integration": "node --test tests/integration-tests/*.test.mjs",
    "validate": "node scripts/pure-saas.mjs validate",
    "contrast": "node scripts/pure-saas.mjs contrast",
    "check-tokens": "node scripts/pure-saas.mjs check-tokens"
  },
  "keywords": [
    "ai-agent",
    "ai-design-skill",
    "ui-ux",
    "claude-code",
    "cursor",
    "codex",
    "windsurf",
    "design-system",
    "anti-slop",
    "web-design",
    "frontend-craft"
  ],
  "author": "Pure SaaS Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "scripts",
    "references",
    "commands",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    ".cursorrules",
    "GEMINI.md",
    ".windsurfrules",
    "LICENSE"
  ]
}

