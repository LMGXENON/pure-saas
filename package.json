{
  "name": "pure-saas",
  "version": "1.0.0",
  "description": "Universal AI-agent skill and design enforcement toolkit for professional web design and UI/UX without generic AI patterns",
  "type": "module",
  "main": "scripts/pure-saas.mjs",
  "bin": {
    "pure-saas": "./cli/bin/pure-saas.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "cd pure-saas-website && npm run build",
    "build:demos": "cd demo-without-puresaas && npm run build && cd ../demo-with-puresaas && npm run build",
    "demo:without": "cd demo-without-puresaas && npm run dev",
    "demo:with": "cd demo-with-puresaas && npm run dev",
    "export:refs": "node scripts/export-website-references.mjs",
    "generate:docs": "node scripts/generators/generate-docs-data.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:sample": "node scripts/test-sample-project.mjs",
    "test:landing": "node scripts/test-landing-workflow.mjs",
    "validate": "node scripts/pure-saas.mjs validate",
    "validate-refs": "node scripts/validate-references.mjs",
    "contrast": "node scripts/pure-saas.mjs contrast",
    "check-tokens": "node scripts/pure-saas.mjs check-tokens",
    "audit": "node scripts/pure-saas.mjs audit",
    "context": "node scripts/pure-saas.mjs context",
    "doctor": "node scripts/pure-saas.mjs doctor",
    "browser": "node scripts/pure-saas.mjs browser",
    "3d": "node scripts/pure-saas.mjs 3d",
    "style": "node scripts/pure-saas.mjs style"
  },
  "keywords": [
    "ai-agent",
    "ai-design-skill",
    "ui-ux",
    "claude-code",
    "cursor",
    "codex",
    "windsurf",
    "design-system",
    "anti-slop",
    "web-design",
    "frontend-craft"
  ],
  "author": "Pure SaaS Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "skill",
    "commands",
    "cli",
    "scripts",
    "SKILL.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "PRODUCT.md",
    "DESIGN.md",
    "README.md",
    ".cursorrules",
    ".windsurfrules",
    "LICENSE"
  ]
}

