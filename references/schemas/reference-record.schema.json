{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pure-saas.org/schemas/reference-record.schema.json",
  "title": "Pure SaaS Reference Record Schema",
  "description": "Schema for structured design references extracted from existing websites or assets.",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_url",
    "capture_date",
    "inspection_method",
    "status",
    "confidence_levels",
    "typography_observations",
    "color_observations",
    "layout_observations"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "source_url": { "type": "string" },
    "capture_date": { "type": "string" },
    "inspection_method": {
      "type": "string",
      "enum": ["dom-computed-styles", "screenshot-analysis", "static-css-source", "hybrid"]
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved"]
    },
    "confidence_levels": {
      "type": "object",
      "required": ["typography", "colors", "spacing", "interactions"],
      "properties": {
        "typography": { "type": "string", "enum": ["measured", "estimated", "unknown"] },
        "colors": { "type": "string", "enum": ["measured", "estimated", "unknown"] },
        "spacing": { "type": "string", "enum": ["measured", "estimated", "unknown"] },
        "interactions": { "type": "string", "enum": ["measured", "estimated", "unknown"] }
      }
    },
    "brand_archetype": { "type": "string" },
    "typography_observations": {
      "type": "object",
      "properties": {
        "primary_family": { "type": "string" },
        "mono_family": { "type": "string" },
        "h1_size": { "type": "string" },
        "body_size": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "color_observations": {
      "type": "object",
      "properties": {
        "canvas": { "type": "string" },
        "surface": { "type": "string" },
        "text_primary": { "type": "string" },
        "accent": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "layout_observations": {
      "type": "object",
      "properties": {
        "container_width": { "type": "string" },
        "grid_pattern": { "type": "string" },
        "density": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "component_observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anti_slop_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

